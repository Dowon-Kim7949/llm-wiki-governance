{
  "name": "llm-wiki-vue3-typescript-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable demo: LLM-WIKI Governance on a small Vue 3 + TypeScript task list.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
