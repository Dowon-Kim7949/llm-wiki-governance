    "type-check": "vue-tsc --noEmit",
    "demo": "node scripts/demo.mjs walkthrough",
    "demo:workspace": "node scripts/demo.mjs workspace",
    "demo:enable-gate": "node scripts/demo.mjs enable-gate",
    "demo:enrich": "node scripts/demo.mjs enrich",
    "demo:change-source": "node scripts/demo.mjs change-source",
    "demo:update-doc": "node scripts/demo.mjs update-doc"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "llm-wiki-governance": "^1.35.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vue-tsc": "^3.3.11"
  }
